# ============================================================
# NIMMY — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Supabase (required for cloud sync, optional for local-only mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is SERVER-ONLY. Never ship in mobile/web client.
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI Brain (Python/FastAPI backend) ---
GEMINI_API_KEY=
NIMMY_AI_BASE_URL=http://localhost:8001

# --- Mobile App (passed via --dart-define) ---
NIMMY_TIMEZONE=Asia/Kolkata

# --- Web (Next.js) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
